@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_EmpLayout.cshtml";
    
}

<div class="text-center">
    <h1 class="display-4">Hello! @ViewBag.name</h1>
   
</div>


<div id="grid"></div>
@* <div id="detailsWindow" style="display:none;"></div> *@

<style>
    .k-grid-norecords td {
        text-align: center;
        font-size: 20px;
        font-weight: bold;
        color: red;
        padding: 30px;
    }
</style>

@section Scripts{
   <script>
    $(document).ready(function () {

        loadGrid();

    });

function loadGrid() {
    

    $.ajax({
        url: "/Emp/GetEmpSal" ,
        type: "GET",
        success: function (response) {

            $("#grid").kendoGrid({

                dataSource: {
                    data: response.res,
                    pageSize: 5
                },
                 noRecords: true,

                messages: {
                    noRecords: "Data Not Found"
                },

                height: 500,
                pageable: true,
                sortable: true,
                filterable: true,

               

               columns: [
                    { field: "salaryId", title: "Salary ID" },
                    
                    { field: "month", title: "Month" },
                    { field: "year", title: "Year" },
                    { field: "basic", title: "Basic Salary" },
                    { field: "allow", title: "Allowance" },
                    { field: "deduct", title: "Deduction" },
                    { field: "net", title: "Net Salary" }
                ]
            });

        }
    });
}


@*  *@


   </script>
}


