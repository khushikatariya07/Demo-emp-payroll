@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div >
    <p class="display-4">Employee Records</p>
</div>
<hr />
    
<div id="grid"></div>
@section Scripts{
<script>
    $(document).ready(function () {
        loadGrid();
    });

    function loadGrid() {

        $("#grid").kendoGrid({
            dataSource: {
                transport: {
                    read: {
                        url: "/Admin/GetAllEmpSal",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "res"
                },
                pageSize: 5
            },

            height: 500,
            pageable: true,
            sortable: true,
            filterable: true,

            columns: [
                { field: "salaryId", title: "Salary ID" },
                { field: "name", title: "Employee Name" },
                { field: "month", title: "Month" },
                { field: "year", title: "Year" },
                { field: "basic", title: "Basic Salary" },
                { field: "allow", title: "Allowance" },
                { field: "deduct", title: "Deduction" },
                { field: "net", title: "Net Salary" },

                {
                    template: `<button class="k-buttonn btn-danger" onclick="deleteSalary(#=salaryId#)">Delete</button>`,
                    title: "Actions",
                    width: "150px"
                }
            ]
        });
    }

    function deleteSalary(id) {

        if (!confirm("Are you sure?")) return;

        $.ajax({
            url: "/Admin/DeleteSalary",
            type: "POST",
            data: { salaryId: id },
            success: function () {
                alert("Deleted Successfully");

                // Refresh grid properly
                $("#grid").data("kendoGrid").dataSource.read();
            }
        });
    }
</script>
}